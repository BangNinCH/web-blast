{
  "name": "web-blast",
  "version": "1.0.0",
  "description": "WhatsApp broadcast platform with multi-role management",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@rexxhayanasi/elaina-baileys": "^1.3.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "git": "^0.1.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
